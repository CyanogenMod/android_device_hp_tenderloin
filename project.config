[access "refs/*"]
	owner = group Administrators
	create = group Touchpad Team
	push = group Touchpad Team
	label-Verified = -1..+1 group Touchpad Team
	label-Code-Review = -2..+2 group Touchpad Team
	submit = group Touchpad Team
	forgeAuthor = group Touchpad Team
	forgeCommitter = group Touchpad Team
[submit]
	action = rebase if necessary
